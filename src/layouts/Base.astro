---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, localePath } from '../i18n/utils';
import { languages, hreflangTags, ogLocales, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  active?: string;
}

const { lang, title, description, active } = Astro.props;
const t = useTranslations(lang);
const desc = description ?? t('site.description');
const base = import.meta.env.BASE_URL;

// Matches the routing convention in Header.astro: each nav item's `id` is
// also its language-relative path, except "dashboard" which is the root.
const path = !active || active === 'dashboard' ? '' : active;
const allLangs = Object.keys(languages) as Lang[];
const canonicalUrl = new URL(localePath(lang, path), Astro.site);
// Share preview (LINE, Slack, X…): absolute URL, required by most crawlers.
const ogImage = new URL(`${base.replace(/\/$/, '')}/og.png`, Astro.site);
const pageTitle = `${title} · ${t('site.name')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    {
      allLangs.map((l) => (
        <link rel="alternate" hreflang={hreflangTags[l]} href={new URL(localePath(l, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLang, path), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      allLangs
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t('site.name')} — ${t('site.tagline')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />

    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('common.skipToContent')}</a>
    <Header lang={lang} active={active} />
    <main id="main" class="container">
      <noscript><p class="banner noscript">{t('common.noscript')}</p></noscript>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline data-newtab={t('common.newTab')}>
      // Screen readers get "(opens in a new tab)" on every target=_blank link,
      // including ones the page scripts add later (feeds, popups, lists).
      (() => {
        const label = document.currentScript.dataset.newtab;
        const mark = (root) => {
          for (const a of root.querySelectorAll('a[target="_blank"]:not([data-nt])')) {
            a.dataset.nt = '';
            const s = document.createElement('span');
            s.className = 'visually-hidden';
            s.textContent = ' ' + label;
            a.append(s);
          }
        };
        mark(document);
        new MutationObserver(() => mark(document.body)).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
