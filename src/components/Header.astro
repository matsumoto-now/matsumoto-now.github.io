---
import { useTranslations, localePath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
import { features } from '../features';

interface Props {
  lang: Lang;
  active?: string;
}

const { lang, active = 'dashboard' } = Astro.props;
const t = useTranslations(lang);
const allLangs = Object.keys(languages) as Lang[];

const items = [
  { id: 'dashboard', path: '', label: t('nav.dashboard') },
  ...(features.weatherPage ? [{ id: 'weather', path: 'weather', label: t('nav.weather') }] : []),
  ...(features.earthquakesPage
    ? [{ id: 'earthquakes', path: 'earthquakes', label: t('nav.earthquakes') }]
    : []),
  ...(features.alertsPage ? [{ id: 'alerts', path: 'alerts', label: t('nav.alerts') }] : []),
  ...(features.busesPage ? [{ id: 'buses', path: 'buses', label: t('nav.buses') }] : []),
  ...(features.sheltersPage
    ? [{ id: 'shelters', path: 'shelters', label: t('nav.shelters') }]
    : []),
  ...(features.medicalPage
    ? [{ id: 'medical', path: 'medical', label: t('nav.medical') }]
    : []),
  ...(features.safetyPage ? [{ id: 'safety', path: 'safety', label: t('nav.safety') }] : []),
  ...(features.firePage ? [{ id: 'fire', path: 'fire', label: t('nav.fire') }] : []),
  ...(features.garbagePage ? [{ id: 'garbage', path: 'garbage', label: t('nav.garbage') }] : []),
  ...(features.resourcesPage
    ? [{ id: 'resources', path: 'resources', label: t('nav.resources') }]
    : []),
  { id: 'about', path: 'about', label: t('nav.about') },
];

// On phones only these stay in the strip (plus the current page); the rest sit
// behind a "Menu" disclosure so the header no longer wraps to 4–5 rows.
const primary = new Set(['dashboard', 'alerts', 'shelters', 'medical']);
const isPrimary = (id: string) => primary.has(id) || id === active;

const activeItem = items.find((i) => i.id === active);
const activePath = activeItem?.path ?? '';
---

<header class="site-header">
  <div class="container">
    <div class="bar">
      <a class="brand" href={localePath(lang)}>
        <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="1" y="1" width="30" height="30" rx="8" fill="var(--accent)"></rect>
          <path d="M5 24 L12 10 L16 17 L19 12 L27 24 Z" fill="#fff" opacity="0.92"></path>
          <circle cx="23" cy="8.5" r="2.6" fill="#fff" opacity="0.85"></circle>
        </svg>
        <span>
          {t('site.name')}
          <span class="tagline">{t('site.tagline')}</span>
        </span>
      </a>
      <div class="header-actions">
        <select
          class="pill-btn lang-select"
          data-lang-select
          aria-label={t('common.language')}
          data-paths={JSON.stringify(Object.fromEntries(allLangs.map((l) => [l, localePath(l, activePath)])))}
        >
          {allLangs.map((l) => (
            <option value={l} lang={l} selected={l === lang}>
              {languages[l]}
            </option>
          ))}
        </select>
        <button class="pill-btn icon-btn" type="button" data-theme-toggle aria-label={t('common.themeToggle')}>
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></g></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" fill="currentColor"></path></svg>
        </button>
      </div>
    </div>
    <nav class="site-nav" aria-label={t('nav.menu')}>
      {
        items.map((item) => (
          <a
            href={localePath(lang, item.path)}
            class={isPrimary(item.id) ? undefined : 'nav-secondary'}
            aria-current={item.id === active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <details class="nav-more">
        <summary>{t('nav.menu')}</summary>
        <div class="nav-more-panel">
          {
            items
              .filter((item) => !isPrimary(item.id))
              .map((item) => <a href={localePath(lang, item.path)}>{item.label}</a>)
          }
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  // Theme toggle: stamp data-theme so the choice wins over the OS setting both ways.
  const toggle = document.querySelector('[data-theme-toggle]');
  const isDark = () =>
    (document.documentElement.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
  toggle?.setAttribute('aria-pressed', String(isDark()));
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    toggle.setAttribute('aria-pressed', String(next === 'dark'));
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Language dropdown: remember the choice (for the root redirect) and navigate.
  const langSelect = document.querySelector<HTMLSelectElement>('[data-lang-select]');
  langSelect?.addEventListener('change', () => {
    const lang = langSelect.value;
    try {
      localStorage.setItem('lang', lang);
    } catch {}
    const paths = JSON.parse(langSelect.dataset.paths ?? '{}') as Record<string, string>;
    if (paths[lang]) location.href = paths[lang];
  });
</script>

<script>
  // Close the mobile "Menu" disclosure on outside tap or Escape.
  const more = document.querySelector<HTMLDetailsElement>('.nav-more');
  document.addEventListener('click', (e) => {
    if (more?.open && !more.contains(e.target as Node)) more.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && more?.open) {
      more.open = false;
      more.querySelector('summary')?.focus();
    }
  });
</script>
