---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang } from '../../i18n/utils';
import { features } from '../../features';

export function getStaticPaths() {
  return features.sheltersPage ? langParams : [];
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('shelter.title')} description={t('shelter.subtitle')} active="shelters">
  <h1 class="page-title">{t('shelter.title')}</h1>
  <p class="page-sub">{t('shelter.subtitle')}</p>

  <div class="grid">
    <section class="card col-12" aria-labelledby="nearest-h">
      <div class="nearest-head">
        <div>
          <h2 id="nearest-h">{t('shelter.nearestTitle')}</h2>
          <p class="card-sub">{t('shelter.nearestHint')}</p>
        </div>
        <button class="primary-btn" type="button" data-nearest-btn disabled>
          <span aria-hidden="true">⌖</span>
          {t('map.locate')}
        </button>
      </div>
      <ol class="nearest-list" data-nearest-list aria-live="polite"></ol>
    </section>
    <section class="card col-12" aria-labelledby="map-h">
      <h2 class="visually-hidden" id="map-h">{t('shelter.evacSites')}</h2>
      <div class="filter-row" data-widget="hazard-filter" role="group" aria-label={t('shelter.filterLabel')}>
        <span class="flabel">{t('shelter.filterLabel')}</span>
      </div>
      <div class="map-frame map-tall" id="shelter-map"></div>
      <p class="card-note">{t('shelter.evacNote')}</p>
      <p class="card-note">
        <a href="https://www.city.matsumoto.nagano.jp/site/bousai/" target="_blank" rel="noopener">
          {t('res.bousai.name')} ↗
        </a>
        {' · '}
        <a
          href="https://disaportal.gsi.go.jp/maps/index.html?ll=36.238,137.972&z=13&base=pale&vs=c1j0l0u0t0h0z0"
          target="_blank"
          rel="noopener"
        >
          {t('shelter.hazardPortal')} ↗
        </a>
      </p>
      <p class="card-note">
        {t('shelter.zoomNote')}
        {' · '}
        {t('shelter.attribution')}
      </p>
    </section>
  </div>
</Base>

<script>
  import { initShelterPage } from '../../lib/shelter-page';
  initShelterPage();
</script>
