---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang, localePath } from '../../i18n/utils';
import { features } from '../../features';

export function getStaticPaths() {
  return langParams;
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('nav.dashboard')} description={t('site.tagline')} active="dashboard">
  <h1 class="visually-hidden">{t('site.name')}</h1>
  <div class="grid">
    {
      features.warnings && (
        <section id="warnings" class="banner loading col-12" aria-live="polite" data-widget="warnings">
          <p class="placeholder flush">
            {t('common.loading')}
          </p>
        </section>
      )
    }

    {
      /* Who to call, in the order you would need them. Weather, air quality and
         forecasts live on the weather page — the dashboard is for the things
         that matter when something is wrong. */
      features.emergencyContacts && (
        <section class="card fit col-4">
          <h2>{t('dash.fireTitle')}</h2>
          <ul class="contact-list">
            <li>
              <a class="tel" href="tel:119">119</a>
              <div class="what">
                <div class="title">{t('fire.emergency119')}</div>
                <div class="meta">{t('fire.emergency119Desc')}</div>
              </div>
            </li>
          </ul>
          {features.firePage && (
            <p class="card-note">
              <a href={localePath(lang, 'fire')}>{t('dash.viewPage')} →</a>
            </p>
          )}
        </section>
      )
    }

    {
      features.emergencyContacts && (
        <section class="card fit col-4">
          <h2>{t('dash.policeTitle')}</h2>
          <ul class="contact-list">
            <li>
              <a class="tel" href="tel:110">110</a>
              <div class="what">
                <div class="title">{t('safety.police110')}</div>
                <div class="meta">{t('safety.police110Desc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:%239110">#9110</a>
              <div class="what">
                <div class="title">{t('safety.consult')}</div>
                <div class="meta">{t('safety.consultDesc')}</div>
              </div>
            </li>
          </ul>
          {features.safetyPage && (
            <p class="card-note">
              <a href={localePath(lang, 'safety')}>{t('dash.viewPage')} →</a>
            </p>
          )}
        </section>
      )
    }

    {
      features.emergencyContacts && (
        <section class="card fit col-4">
          <h2>{t('dash.medicalTitle')}</h2>
          <ul class="contact-list">
            <li>
              <a class="tel" href="tel:%237119">#7119</a>
              <div class="what">
                <div class="title">{t('med.adult')}</div>
                <div class="meta">{t('med.adultDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:%238000">#8000</a>
              <div class="what">
                <div class="title">{t('med.child')}</div>
                <div class="meta">{t('med.childDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:0263380622">0263-38-0622</a>
              <div class="what">
                <div class="title">{t('med.night')}</div>
                <div class="meta">{t('med.nightDesc')}</div>
              </div>
            </li>
          </ul>
          {features.medicalPage && (
            <p class="card-note">
              <a href={localePath(lang, 'medical')}>{t('dash.viewPage')} →</a>
            </p>
          )}
        </section>
      )
    }

    {
      features.quakesPreview && (
        <section class="card col-12">
          <div class="card-head">
            <h2>{t('quakes.title')}</h2>
            {features.earthquakesPage && (
              <a href={localePath(lang, 'earthquakes')}>{t('quakes.viewAll')} →</a>
            )}
          </div>
          <p class="card-sub">{t('quakes.localSub')}</p>
          <div data-widget="quakes">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<script>
  import { initWidgets } from '../../lib/dashboard';
  initWidgets();
</script>
