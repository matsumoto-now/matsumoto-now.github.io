---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang, localePath } from '../../i18n/utils';
import { features } from '../../features';

export function getStaticPaths() {
  return langParams;
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('nav.dashboard')} description={t('site.tagline')} active="dashboard">
  <h1 class="visually-hidden">{t('site.name')}</h1>
  <div class="grid">
    {
      features.warnings && (
        <section id="warnings" class="banner loading col-12" aria-live="polite" data-widget="warnings">
          <p class="placeholder flush">
            {t('common.loading')}
          </p>
        </section>
      )
    }

    {
      /* Who to call, in the order you would need them: the three numbers for
         "something is wrong now" as big tap targets, the advice lines below.
         Weather, air quality and forecasts live on the weather page. */
      features.emergencyContacts && (
        <section class="card col-12" aria-labelledby="call-h">
          <h2 id="call-h">{t('dash.callTitle')}</h2>
          <ul class="call-grid">
            <li>
              <a class="call-tile critical" href="tel:119">
                <span class="call-num">119</span>
                <span class="call-title">{t('fire.emergency119')}</span>
                <span class="call-desc">{t('med.emergencyScope')}</span>
              </a>
            </li>
            <li>
              <a class="call-tile" href="tel:110">
                <span class="call-num">110</span>
                <span class="call-title">{t('safety.police110')}</span>
                <span class="call-desc">{t('safety.police110Desc')}</span>
              </a>
            </li>
            <li>
              <a class="call-tile" href="tel:%237119">
                <span class="call-num">#7119</span>
                <span class="call-title">{t('med.adult')}</span>
                <span class="call-desc">{t('med.adultDesc')}</span>
              </a>
            </li>
          </ul>
          <ul class="contact-list call-more">
            <li>
              <a class="tel" href="tel:%238000">#8000</a>
              <div class="what">
                <div class="title">{t('med.child')}</div>
                <div class="meta">{t('med.childDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:0263380622">0263-38-0622</a>
              <div class="what">
                <div class="title">{t('med.night')}</div>
                <div class="meta">{t('med.nightDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:%239110">#9110</a>
              <div class="what">
                <div class="title">{t('safety.consult')}</div>
                <div class="meta">{t('safety.consultDesc')}</div>
              </div>
            </li>
          </ul>
          <p class="card-note call-links">
            {features.firePage && <a href={localePath(lang, 'fire')}>{t('nav.fire')} <span aria-hidden="true">→</span></a>}
            {features.safetyPage && <a href={localePath(lang, 'safety')}>{t('nav.safety')} <span aria-hidden="true">→</span></a>}
            {features.medicalPage && <a href={localePath(lang, 'medical')}>{t('nav.medical')} <span aria-hidden="true">→</span></a>}
          </p>
        </section>
      )
    }

    {
      features.quakesPreview && (
        <section class="card col-12">
          <div class="card-head">
            <h2>{t('quakes.title')}</h2>
            {features.earthquakesPage && (
              <a href={localePath(lang, 'earthquakes')}>{t('quakes.viewAll')} <span aria-hidden="true">→</span></a>
            )}
          </div>
          <p class="card-sub">{t('quakes.localSub')}</p>
          <div data-widget="quakes">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<script>
  import { initWidgets } from '../../lib/dashboard';
  initWidgets();
</script>
