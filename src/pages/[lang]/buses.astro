---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang } from '../../i18n/utils';
import { features } from '../../features';

export function getStaticPaths() {
  return features.busesPage ? langParams : [];
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('bus.title')} description={t('bus.subtitle')} active="buses">
  <h1 class="page-title">{t('bus.title')}</h1>
  <p class="page-sub">{t('bus.subtitle')}</p>

  <div class="grid">
    <section class="card col-12" aria-labelledby="bus-map-h">
      <h2 class="visually-hidden" id="bus-map-h">{t('bus.title')}</h2>
      <label class="gb-label" for="bus-stop-search">{t('bus.searchStop')}</label>
      <input
        class="gb-input bus-search"
        id="bus-stop-search"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder={t('bus.searchPlaceholder')}
      />
      <div class="combo-list" id="bus-stop-results" hidden></div>
      <div class="bus-recent" data-bus-recent hidden></div>
      <div class="map-frame map-tall" id="bus-map"></div>
      <p class="card-note">
        {t('bus.zoomNote')}
        {' · '}
        {t('bus.attribution')}
      </p>
    </section>

    <section class="card col-12" id="bus-stop-timetable" aria-live="polite" hidden>
      <h2>{t('bus.stopTimetable')}</h2>
      <div data-widget="bus-timetable"></div>
    </section>

    <section class="card col-12">
      <h2>{t('bus.routes')}</h2>
      <div data-widget="bus-routes">
        <p class="placeholder">{t('common.loading')}</p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initBusPage } from '../../lib/bus-page';
  initBusPage();
</script>
