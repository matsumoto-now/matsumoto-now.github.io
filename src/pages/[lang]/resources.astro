---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang } from '../../i18n/utils';
import { features } from '../../features';
import type { UIKey } from '../../i18n/ui';

export function getStaticPaths() {
  return features.resourcesPage ? langParams : [];
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);

// Names/descriptions live in the locale dictionaries (res.<slug>.name/desc).
const all: { slug: string; url: string }[] = [
  { slug: 'city', url: 'https://www.city.matsumoto.nagano.jp/' },
  { slug: 'bousai', url: 'https://www.city.matsumoto.nagano.jp/site/bousai/' },
  { slug: 'anshin', url: 'https://www.city.matsumoto.nagano.jp/soshiki/7/2746.html' },
  { slug: 'garbage', url: 'https://www.city.matsumoto.nagano.jp/soshiki/58/78317.html' },
  // The medical association's site policy asks that links point to the top page.
  { slug: 'dutyDoctor', url: 'https://www.matsu-med.or.jp/' },
  { slug: 'kawabou', url: 'https://www.river.go.jp/index' },
  { slug: 'soramame', url: 'https://soramame.env.go.jp/' },
  { slug: 'raipolice', url: 'https://www.raipolice-nagano.jp/' },
  { slug: 'bus', url: 'https://www.city.matsumoto.nagano.jp/soshiki/222/3237.html' },
  { slug: 'line', url: 'https://page.line.me/ric7546t' },
];
const url = (slug: string) => all.find((r) => r.slug === slug)!.url;
// Grouped by when you'd need them: emergencies first.
const groups: { title: UIKey; slugs: string[] }[] = [
  { title: 'res.groupEmergency', slugs: ['bousai', 'kawabou', 'dutyDoctor', 'raipolice', 'anshin'] },
  { title: 'res.groupCity', slugs: ['city', 'garbage', 'bus'] },
  { title: 'res.groupInfo', slugs: ['line', 'soramame'] },
];
---

<Base lang={lang} title={t('resources.title')} description={t('resources.subtitle')} active="resources">
  <h1 class="page-title">{t('resources.title')}</h1>
  <p class="page-sub">{t('resources.subtitle')}</p>

  <div class="grid">
    {
      groups.map((g) => (
        <section class="card col-12">
          <h2>{t(g.title)}</h2>
          <ul class="link-list">
            {g.slugs.map((slug) => (
              <li>
                <a href={url(slug)} target="_blank" rel="noopener">
                  {t(`res.${slug}.name` as UIKey)} <span aria-hidden="true">↗</span>
                </a>
                <p>{t(`res.${slug}.desc` as UIKey)}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
